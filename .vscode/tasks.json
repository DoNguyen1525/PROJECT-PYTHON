{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ingest CafeF (run)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "scripts.ingest_cafef",
        "${env:DATA_SRC_DIR}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run API (uvicorn)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "uvicorn",
        "scripts.api_demo_fast:app",
        "--reload",
        "--port",
        "9000"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
