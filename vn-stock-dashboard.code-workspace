{
    "folders": [
        {
            "name": "VN Stock Dashboard",
            "path": "."
        }
    ],
    "settings": {
        "files.associations": {
            "*.py": "python",
            "*.html": "html",
            "*.css": "css",
            "*.js": "javascript"
        },
        "python.defaultInterpreterPath": "/opt/anaconda3/bin/python",
        "liveServer.settings.root": "/frontend",
        "liveServer.settings.port": 3000
    },
    "extensions": {
        "recommendations": [
            "ms-python.python",
            "ritwickdey.liveserver",
            "github.copilot",
            "github.copilot-chat",
            "bradlc.vscode-tailwindcss"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start Backend",
                "type": "shell",
                "command": "python",
                "args": ["-m", "uvicorn", "api.main:app", "--reload"],
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "problemMatcher": []
            },
            {
                "label": "Start Frontend",
                "type": "shell",
                "command": "python",
                "args": ["-m", "http.server", "3000"],
                "options": {
                    "cwd": "${workspaceFolder}/frontend"
                },
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                }
            },
            {
                "label": "Run Data Processor",
                "type": "shell",
                "command": "python",
                "args": ["scripts/data_processor_historical.py"],
                "group": "build"
            }
        ]
    }
}